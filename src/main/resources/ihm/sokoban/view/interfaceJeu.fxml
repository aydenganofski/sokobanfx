<BorderPane fx:id="pane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ihm.sokoban.view.InterfaceJeuController">
   <top>
      <MenuBar BorderPane.alignment="CENTER">
        <menus>
            <Menu mnemonicParsing="false" text="Jeu">
              <items>
                <Menu fx:id="menuTutoriels" mnemonicParsing="false" text="Tutoriel" />
                <Menu fx:id="menuSokoban" mnemonicParsing="false" text="Niveaux Sokoban" />
              </items>
            </Menu>
            <Menu fx:id="menuXSB" mnemonicParsing="false" text="Charger un niveau">
