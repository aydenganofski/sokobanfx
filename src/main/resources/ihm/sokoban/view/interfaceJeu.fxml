                  <MenuItem mnemonicParsing="false" onAction="#chargerDossierXSB" text="Charger un niveau à partir d'un dossier" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Options">
              <items>
                <MenuItem fx:id="MIaide" mnemonicParsing="false" onAction="#aide" text="Comment jouer ?" />
                  <Menu mnemonicParsing="false" text="Son">
                     <items>
                        <CustomMenuItem hideOnClick="false" mnemonicParsing="false">
                           <content>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <Label styleClass="items" text="Volume :" />
                                    <Slider fx:id="sliderVolume" max="1.0" value="0.5" />
                                 </children>
                              </HBox>
                           </content>
                        </CustomMenuItem>
                        <CheckMenuItem fx:id="checkBruitages" mnemonicParsing="false" text="Couper les bruitages" />
                        <CheckMenuItem fx:id="checkMusique" mnemonicParsing="false" text="Couper la musique" />
                     </items>
                  </Menu>
                  <Menu mnemonicParsing="false" text="Thème">
                    <items>
                      <MenuItem mnemonicParsing="false" onAction="#actionThemeClair" text="Clair" />
                        <MenuItem mnemonicParsing="false" onAction="#actionThemeSombre" text="Sombre" />
                        <MenuItem mnemonicParsing="false" onAction="#actionThemeRose" text="Rose" />
                        <MenuItem mnemonicParsing="false" onAction="#actionThemeBleu" text="Bleu" />
                        <MenuItem mnemonicParsing="false" onAction="#actionThemeMaruigi" text="Maruigi" />
                    </items>
                  </Menu>
              <MenuItem mnemonicParsing="false" onAction="#credit" text="À propos" />
                  <MenuItem fx:id="MIMenuPrincipal" mnemonicParsing="false" onAction="#retourMP" text="Menu principal" />
                  <MenuItem fx:id="MIQuitter" mnemonicParsing="false" onAction="#quitter" text="Quitter" />
              </items>
            </Menu>
        </menus>
      </MenuBar>
   </top>
   <bottom>
      <ButtonBar buttonMinWidth="20.0" prefHeight="53.0" prefWidth="700.0" BorderPane.alignment="CENTER_RIGHT">
        <buttons>
            <Button fx:id="btnPrecedent" mnemonicParsing="false" onAction="#precedent" styleClass="bouton-jeu" text="Précedent">
               <padding>
                  <Insets bottom="5.0" />
               </padding></Button>
            <Button fx:id="btnAnnuler" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" nodeOrientation="LEFT_TO_RIGHT" onAction="#annuler" styleClass="bouton-jeu" text="Annuler" />
            <Button fx:id="btnRecommencer" mnemonicParsing="false" onAction="#recommencer" styleClass="bouton-jeu" text="Recommencer" />
            <Button fx:id="btnSuivant" mnemonicParsing="false" onAction="#suivant" styleClass="bouton-jeu" text="Suivant" />
        </buttons>
